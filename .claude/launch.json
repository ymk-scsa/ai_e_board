{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eval-boards-static",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "outputs/eval"],
      "port": 8765
    },
    {
      "name": "streamlit-app",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.headless", "true", "--server.port", "8501", "--server.address", "127.0.0.1"],
      "port": 8501
    }
  ]
}
