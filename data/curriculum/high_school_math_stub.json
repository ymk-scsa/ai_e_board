{
  "curriculum_version": "高等学校学習指導要領（平成30年告示）",
  "subject_area": "数学",
  "subjects": [
    {
      "subject_name": "数学I",
      "units": [
        {
          "unit_name": "数と式",
          "topics": ["整式の加法・減法・乗法", "因数分解", "実数", "1次不等式"]
        },
        {
          "unit_name": "2次関数",
          "topics": [
            "2次関数とそのグラフ",
            "平方完成",
            "2次関数の最大・最小",
            "2次方程式・2次不等式"
          ],
          "key_formulas": [
            "y = a(x-p)^2 + q",
            "y = ax^2 + bx + c"
          ]
        },
        {
          "unit_name": "図形と計量",
          "topics": ["三角比", "正弦定理・余弦定理", "空間図形の計量"]
        },
        {
          "unit_name": "データの分析",
          "topics": ["分散と標準偏差", "散布図と相関係数"]
        }
      ]
    },
    {
      "subject_name": "数学A",
      "units": [
        {
          "unit_name": "場合の数と確率",
          "topics": [
            "集合の要素の個数",
            "場合の数（和の法則・積の法則）",
            "順列 (nPr)",
            "円順列・重複順列",
            "組合せ (nCr)",
            "確率とその基本性質",
            "独立な試行と確率",
            "条件付き確率"
          ],
          "key_formulas": [
            "{}_{n}P_{r} = n(n-1)(n-2)\\cdots(n-r+1)",
            "n! = n(n-1)\\cdots 2 \\cdot 1",
            "{}_{n}C_{r} = \\frac{{}_{n}P_{r}}{r!}"
          ]
        },
        {
          "unit_name": "図形の性質",
          "topics": ["三角形の性質", "円の性質", "作図", "空間図形"]
        },
        {
          "unit_name": "数学と人間の活動",
          "topics": ["約数と倍数", "ユークリッドの互除法", "記数法"]
        }
      ]
    }
  ]
}
